<template>
  <UCard class="portfolio-card">
    <template #header>
      <div class="flex items-center justify-between">
        <h3>{{ title }}</h3>
        <UBadge :color="statusColor">{{ status }}</UBadge>
      </div>
    </template>
    
    <slot />
  </UCard>
</template>

<script setup lang="ts">
interface Props {
  title: string;
  status: string;
}

const props = defineProps<Props>();

const statusColor = computed<string>(() => {
  return props.status === 'active' ? 'green' : 'gray';
});
</script>


{
  "name": "wen365",
  "version": "1.0.0",
  "description": "Full-stack crypto portfolio tracker demo built with Nuxt 4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepare": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf node_modules pnpm-lock.yaml .nuxt .output",
    "reinstall": "pnpm clean && pnpm install"
  },
  "dependencies": {
    "@nuxt/ui": "^4.1.0",
    "@reown/appkit": "^1.8.13",
    "@reown/appkit-adapter-wagmi": "^1.8.13",
    "@reown/appkit-siwe": "1.8.14",
    "@tanstack/vue-query": "^5.90.7",
    "@tanstack/vue-table": "8.21.3",
    "@unovis/ts": "1.6.2",
    "@unovis/vue": "1.6.2",
    "@wagmi/vue": "^0.3.2",
    "date-fns": "^4.1.0",
    "lodash-es": "4.17.21",
    "nuxt-auth-utils": "0.5.25",
    "siwe": "3.0.0",
    "viem": "^2.38.6",
    "vue": "^3.5.24",
    "wagmi": "^2.19.2",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxt/eslint": "1.10.0",
    "@nuxt/test-utils": "^3.20.1",
    "@nuxtjs/supabase": "^2.0.3",
    "@pinia/nuxt": "^0.11.2",
    "@rushstack/eslint-patch": "^1.12.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vue/devtools-api": "^8.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.4.0",
    "happy-dom": "^20.0.10",
    "nuxt": "^4.2.1",
    "playwright-core": "^1.56.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "vitest": "^4.0.8",
    "vue-tsc": "3.1.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.14.0"
}

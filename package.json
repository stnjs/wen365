    "@tanstack/vue-query": "^5.100.9",
    "@tanstack/vue-table": "8.21.3",
    "@unovis/ts": "^1.6.5",
    "@unovis/vue": "^1.6.5",
    "@wagmi/vue": "^0.3.2",
    "date-fns": "^4.1.0",
    "lodash-es": "^4.18.1",
    "nuxt-auth-utils": "^0.5.29",
    "siwe": "3.0.0",
    "viem": "^2.48.11",
    "vue": "^3.5.34",
    "wagmi": "^2.19.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",

# Reown AppKit Project ID
# Get this from https://cloud.reown.com (formerly WalletConnect Cloud)
VITE_REOWN_PROJECT_ID=your_project_id_here

# API Keys (optional for development)
# Covalent API for blockchain data
VITE_COVALENT_API_KEY=your_covalent_key_here

# Alchemy API for Ethereum data
VITE_ALCHEMY_API_KEY=your_alchemy_key_here

# Etherscan API for transaction data
VITE_ETHERSCAN_API_KEY=your_etherscan_key_here

# Notification Services (optional)
# SendGrid for email notifications
VITE_SENDGRID_API_KEY=your_sendgrid_key_here

# Telegram Bot for notifications
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here 
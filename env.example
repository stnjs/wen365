# Reown AppKit (required for SIWE auth)
REOWN_PROJECT_ID=your-reown-project-id

# Session encryption (required for auth - min 32 chars)
# Generate: openssl rand -hex 32
NUXT_SESSION_PASSWORD=your-random-secret-here

# Alchemy API (required for portfolio and snapshots)
ALCHEMY_API_KEY=your-alchemy-api-key

# Optional: comma-separated Alchemy network slugs to narrow the active set.
# When unset, all networks from shared/config/networks.ts are queried.
# Valid options: eth-mainnet, base-mainnet, arb-mainnet, opt-mainnet, matic-mainnet
SUPPORTED_NETWORKS=

# Supabase (required for portfolio snapshots)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key

# CRON secret (required for snapshot endpoint - min 16 chars)
# Generate: openssl rand -hex 32
CRON_SECRET=your-random-secret-here
